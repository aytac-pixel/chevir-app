<?xml version="1.0" encoding="utf-8"?>
<!-- Registers the league check that runs while Chevir is closed (classes in Assets/Plugins/Android/LeagueWatch*.java). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.chevir.leaguewatch">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <receiver android:name="com.chevir.leaguewatch.LeagueWatchReceiver" android:exported="false" />
        <receiver android:name="com.chevir.leaguewatch.LeagueWatchBoot" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
